:open_hook_hive
"%SYS%\reg.exe" load "%HOOK_HIVE%" "@@SYSTEM_HIVE@@" >>"%LOG%" 2>&1 || exit /b 1
@@BACKUP_LINE@@set "HOOK_KEY=%HOOK_HIVE%\Select"
set "HOOK_NAME=Default"
call :read_hook || goto hook_failed
set /a "CS=ACTUAL" >nul 2>&1 || goto hook_failed
if %CS% LSS 1 goto hook_failed
if %CS% GTR 999 goto hook_failed
set "CS=00%CS%"
set "CS=%CS:~-3%"
exit /b 0

:read_hook
set "ACTUAL="
"%SYS%\reg.exe" query "%HOOK_KEY%" /v "%HOOK_NAME%" >"%JOB%\hook-value.txt" 2>>"%LOG%" || exit /b 1
for /f "usebackq tokens=1,2,3" %%A in ("%JOB%\hook-value.txt") do if /i "%%A"=="%HOOK_NAME%" if /i "%%B"=="REG_DWORD" set "ACTUAL=%%C"
if not defined ACTUAL exit /b 1
exit /b 0

:inspect_hook
call :read_hook || exit /b 1
(>>"%JOB%\%PHASE%-values.txt" echo "%HOOK_KEY%" /v "%HOOK_NAME%" was %ACTUAL%) || exit /b 1
if not defined HOOK_EXPECTED exit /b 0
if /i "%ACTUAL%"=="%HOOK_EXPECTED%" exit /b 0
if /i "%ACTUAL%"=="%HOOK_NEW%" exit /b 0
exit /b 1

:write_hook
call :read_hook || exit /b 1
if /i "%ACTUAL%"=="%HOOK_NEW%" exit /b 0
"%SYS%\reg.exe" add "%HOOK_KEY%" /v "%HOOK_NAME%" /t REG_DWORD /d "%HOOK_NEW%" /f >>"%LOG%" 2>&1 || exit /b 1
call :read_hook || exit /b 1
if /i not "%ACTUAL%"=="%HOOK_NEW%" exit /b 1
exit /b 0

:hook_failed
>>"%LOG%" echo Hook phase %PHASE% failed. Inspect the value log.
"%SYS%\reg.exe" unload "%HOOK_HIVE%" >>"%LOG%" 2>&1
exit /b 1
